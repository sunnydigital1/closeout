# Copy this file to .env and fill in your own values. Never commit .env.

# --- AI ---------------------------------------------------------------
# gemini (default, has a free tier) | claude | none (rule-based text only)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Leave blank to use the default model list in app/ai.py
GEMINI_MODEL=
# Only needed if AI_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- PayPal (sandbox) ---------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Your "books": the order records Closeout reconciles PayPal against.
# scripts/seed_sandbox.py writes this file for you.
BOOKS_CSV=data/sandbox/orders.csv

# --- Business settings ---------------------------------------------------
BUSINESS_NAME=Larkspur Candle Co.
HOME_COUNTRY=US
BOOK_CURRENCY=USD
# Your expected PayPal fee schedule (used to spot fee surprises)
FEE_PERCENT=3.49
FEE_FIXED=0.49
INTL_FEE_PERCENT=1.50
